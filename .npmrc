# Supply-chain hardening. Install hooks are how the 2026 worms (Shai-Hulud, ChainDrop) run:
# nothing this repo installs needs one -- core-js and es5-ext print a banner, fsevents is
# macOS-only and optional -- so none run. The flip side: npm skips pre/post scripts too, so
# `prepare` no longer sets the commit hook (`git config core.hooksPath .githooks`, once).
ignore-scripts=true
# A release younger than a week is not installed: a hijacked version is usually caught and
# pulled within days. npm >= 11.10 honours it; npm 10 (node 22's) warns and ignores it.
min-release-age=7
